Data/*/evidence/
Artists/*/*/*_preview*.json
Artists/*/*/*_preview*.json.meta.json
Artists/*/*/*_ledger_candidate*.json
Artists/*/*/*_ledger_candidate*.json.meta.json
Artists/*/*/**/*_preview*.json
Artists/*/*/**/*_preview*.json.meta.json
Artists/*/*/**/*_ledger_candidate*.json
Artists/*/*/**/*_ledger_candidate*.json.meta.json
