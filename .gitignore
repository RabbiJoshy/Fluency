# Kaikki.org Wiktionary extracts — large binaries, regenerate with curl.
# Download URL is printed by step_5c_build_senses.py when the file is missing.
# (The pre-existing Data/Spanish/ kaikki files stay tracked for historical reasons.)
Data/French/Senses/wiktionary/kaikki-*.jsonl.gz
Data/French/Senses/wiktionary/kaikki-*.jsonl

# French pipeline: layers + corpora are regenerable / downloaded.
# Source files (FrenchRawWiki.csv, french_ranks.json) and the front-end-served
# vocabulary.index.json + vocabulary.examples.json stay tracked.
Data/French/layers/
Data/French/corpora/

# Dutch pipeline: corpora + big regenerable intermediates (mirror Spanish).
# OpenSubtitles raw (~4.8 GB) + compressed cache (143 MB, over GitHub's file
# limit) + the large examples layers regenerate from source. Small layers
# (sense_menu, mwe_phrases, *.meta.json) stay tracked as the pipeline checkpoint.
Data/Dutch/corpora/
Data/Dutch/layers/examples_raw.json
Data/Dutch/layers/example_store.json

# Stray OpenSubtitles corpus readme that unpacked into the repo root.
/README

