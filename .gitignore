_backups/
.*.checkpoint.json

# Sandbox rebuild artifacts (step_8b --output-suffix) — never commit
*_sandbox*
**/routing_tags_dashboard.html
gittoken.txt
.venv39-old/

# cached embedding vectors (rebuildable, ~110 MB)
Data/Spanish/layers/sense_vectors/*.npy

